{
  "name": "dataharian-dashboard",
  "version": "1.0.0",
  "description": "Public dashboard for the dataharian seismic pipeline. Static, reads one JSON file.",
  "private": true,
  "license": "MIT",
  "author": "Indra Arya",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "basemap": "node scripts/build-basemap.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/familjen-grotesk": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "eslint": "^10.15.0",
    "eslint-plugin-playwright": "^2.12.2",
    "prettier": "^3.10.1",
    "topojson-client": "^3.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "world-atlas": "^2.0.2"
  }
}
